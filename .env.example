# Copy to support_agent/.env
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key
# SUPPORT_AGENT_MODEL=gemini-3.8-flash   # any Gemini model your key can use
# REFUND_AUTO_LIMIT=120   # refunds above this need supervisor approval

# Service-to-service (chat_service <-> console_service)
# CHAT_SERVICE_URL=http://localhost:8000   # console_service: where the chat service runs
# INTERNAL_TOKEN=change-me                 # same value on both services to protect /internal/*
